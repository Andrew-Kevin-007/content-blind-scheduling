# Environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data — every byte is re-downloadable via src/fetch_data.py, and SHA-256
# checksums ARE committed (results/checksums.txt) so integrity is verifiable
# without shipping 4.6 GB through git.
data/

# LaTeX build artifacts
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
*.lof
*.lot
*.spl

# OS
Thumbs.db
desktop.ini
.DS_Store

# NOTE: results/ IS committed on purpose — it is the paper's evidence base.
# NOTE: figures/ IS committed on purpose — needed to build the paper.

# Inspection renders (regenerate with pdftoppm)
paper/pg-*.png
figures/*.png

# Word lock files
~$*

# final/ is the frozen submission set: its .bbl must ship so it rebuilds
!final/source/paper/main.bbl
